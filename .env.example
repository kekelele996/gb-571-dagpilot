# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=dagpilot

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18244
BACKEND_PORT=19244
DB_PORT=17744

# ---- 数据库 ----
DB_NAME=dagpilot
DB_USER=dagpilot
DB_PASSWORD=dagpilot_pw_2026
DB_ROOT_PASSWORD=dagpilot_root_2026

# ---- 安全 ----
JWT_SECRET=dagpilot-jwt-secret-change-me-2026

# ---- 运行时 ----
